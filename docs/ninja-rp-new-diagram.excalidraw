    {
      "id": "0ua0CpRaVjktRJ4vFwRY-",
      "type": "text",
      "x": 14192.282957998445,
      "y": -3314.4094656442066,
      "width": 530.410211713996,
      "height": 612.3434964503043,
      "angle": 0,
      "strokeColor": "#1e1e2e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
