      "updated": 1786391839416,
      "link": null,
      "locked": false,
      "text": "EXTERNAL BACKENDS\n(on Docker HOST machine)\n\nhost.docker.internal:3001\n  → Backend A app\n\nhost.docker.internal:3002\n  → Backend B app\n\nProxy uses extra_hosts to reach them\n(not Docker containers themselves)\n\nRun your backends normally:\n  node app.js  (port 3001/3002)",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "EXTERNAL BACKENDS\n(on Docker HOST machine)\n\nhost.docker.internal:3001\n  → Backend A app\n\nhost.docker.internal:3002\n  → Backend B app\n\nProxy uses extra_hosts to reach them\n(not Docker containers themselves)\n\nRun your backends normally:\n  node app.js  (port 3001/3002)",
      "lineHeight": 1.25,
      "autoResize": true,
