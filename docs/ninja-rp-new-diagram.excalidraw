      "seed": 52761078,
      "version": 37,
      "versionNonce": 1190061098,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786391839416,
      "link": null,
      "locked": false,
      "text": "📋  SERVICE REGISTRY  (src/discovery/registry/dynamic.registry.ts)\n\nMap<id, ServiceInstance>\n\nServiceInstance {\n  id, url,\n  status: \"UP\" | \"DOWN\",\n  registeredAt, lastHeartbeat,\n  metadata?: Record<string,string>\n}\n\nregister(instance)  → status: UP\nderegister(id)      → status: DOWN\nheartbeat(id)       → update lastHeartbeat\ngetHealthy()        → filter status===UP\nget(id)             → ServiceInstance | undefined\n\n⚠  IN-MEMORY only (not Redis/Consul/etcd)\nHeartbeat timeout: 30s\n  Only for metadata.dynamic === \"true\"",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "📋  SERVICE REGISTRY  (src/discovery/registry/dynamic.registry.ts)\n\nMap<id, ServiceInstance>\n\nServiceInstance {\n  id, url,\n  status: \"UP\" | \"DOWN\",\n  registeredAt, lastHeartbeat,\n  metadata?: Record<string,string>\n}\n\nregister(instance)  → status: UP\nderegister(id)      → status: DOWN\nheartbeat(id)       → update lastHeartbeat\ngetHealthy()        → filter status===UP\nget(id)             → ServiceInstance | undefined\n\n⚠  IN-MEMORY only (not Redis/Consul/etcd)\nHeartbeat timeout: 30s\n  Only for metadata.dynamic === \"true\"",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b4x",
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
