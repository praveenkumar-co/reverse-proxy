      "boundElements": [],
      "updated": 1786448763918,
      "link": null,
      "locked": false,
      "text": "CIRCUIT BREAKER\n\nCLOSED\n  ↓  failures >= threshold (3)\nOPEN\n  ↓  recoveryTimeMs (15000ms)\nHALF_OPEN\n  ↓  first success\nCLOSED\n\nfailure → effectiveWeight--\nsuccess → effectiveWeight++",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "CIRCUIT BREAKER\n\nCLOSED\n  ↓  failures >= threshold (3)\nOPEN\n  ↓  recoveryTimeMs (15000ms)\nHALF_OPEN\n  ↓  first success\nCLOSED\n\nfailure → effectiveWeight--\nsuccess → effectiveWeight++",
      "lineHeight": 1.25,
