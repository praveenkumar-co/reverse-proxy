      "text": "📋 DYNAMIC SERVICE REGISTRY (src/discovery/registry/dynamic.registry.ts)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "📋 DYNAMIC SERVICE REGISTRY (src/discovery/registry/dynamic.registry.ts)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YgoZ6Mnw",
      "type": "text",
      "x": 13064,
      "y": 1361,
      "width": 3372,
      "height": 100,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b_3tqxT_5",
      "roundness": null,
      "seed": 53798180,
      "version": 1,
      "versionNonce": 520179050,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789874675272,
      "link": null,
      "locked": false,
      "created": null,
      "text": "• REST API: POST /__registry/register & PUT /__registry/heartbeat/:id\n• In-memory Map<id, ServiceInstance> with UP/DOWN state\n• Background GC: checkHeartbeats() evicts services after 30s timeout\n• Atomic Persistence: Writes temporary file -> atomic POSIX rename\n  proxy_registry_backup.json (survives proxy crashes and restarts!)\n• Event callbacks: onRegister & onDeregister notify LoadBalancer",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• REST API: POST /__registry/register & PUT /__registry/heartbeat/:id\n• In-memory Map<id, ServiceInstance> with UP/DOWN state\n• Background GC: checkHeartbeats() evicts services after 30s timeout\n• Atomic Persistence: Writes temporary file -> atomic POSIX rename\n  proxy_registry_backup.json (survives proxy crashes and restarts!)\n• Event callbacks: onRegister & onDeregister notify LoadBalancer",
      "autoResize": true,
      "lineHeight": 1.25
    },
