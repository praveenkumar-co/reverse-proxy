      "text": "🗃️ HYBRID CACHE MANAGER (src/cache/cache-manager.ts)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🗃️ HYBRID CACHE MANAGER (src/cache/cache-manager.ts)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rd69oO6h",
      "type": "text",
      "x": 14834,
      "y": -899,
      "width": 5172,
      "height": 71,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOkgHYcEb",
      "roundness": null,
      "seed": 681499914,
      "version": 1,
      "versionNonce": 673589889,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789874675272,
      "link": null,
      "locked": false,
      "created": null,
      "text": "• Tiered Dual-Layer Caching: L1 InMemoryLRU + L2 RedisCache\n• get(key): checks L1 -> on miss checks L2 -> populates L1 on hit\n• set(key, val, ttl): sets L1 immediately, sets L2 asynchronously\n• getStats(): reports L1 size/maxSize, hit/miss ratios & L2 connectivity status",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Tiered Dual-Layer Caching: L1 InMemoryLRU + L2 RedisCache\n• get(key): checks L1 -> on miss checks L2 -> populates L1 on hit\n• set(key, val, ttl): sets L1 immediately, sets L2 asynchronously\n• getStats(): reports L1 size/maxSize, hit/miss ratios & L2 connectivity status",
      "autoResize": true,
      "lineHeight": 1.25
    },
