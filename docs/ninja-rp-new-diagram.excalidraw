      "id": "Nz1ZK7CO",
      "type": "text",
      "x": 16594,
      "y": 1361,
      "width": 3372,
      "height": 145,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
