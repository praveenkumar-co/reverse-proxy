      "isDeleted": false,
      "boundElements": [],
      "updated": 1786391839416,
      "link": null,
      "locked": false,
      "text": "ConfigMap\nninja-proxy-config\n\nconfig.yaml:\n  listen: 8080\n  httpsPort: 8443\n  workers: 2\n  loadBalancing:\n    strategy: round-robin\n    failureThreshold: 3\n    recoveryTimeMs: 15000\n  cache:\n    enabled: false\n    host: redis\n  upstreams:\n    - backend-a-svc:3001\n    - backend-b-svc:3002\n\nns: reverse-proxy",
      "fontSize": 23.717529792089252,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "ConfigMap\nninja-proxy-config\n\nconfig.yaml:\n  listen: 8080\n  httpsPort: 8443\n  workers: 2\n  loadBalancing:\n    strategy: round-robin\n    failureThreshold: 3\n    recoveryTimeMs: 15000\n  cache:\n    enabled: false\n    host: redis\n  upstreams:\n    - backend-a-svc:3001\n    - backend-b-svc:3002\n\nns: reverse-proxy",
