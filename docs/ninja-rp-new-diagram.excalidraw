      "updated": 1786538963275,
      "link": null,
      "locked": false,
      "text": "WEBSOCKET PATH  (src/core/proxy/websocket.handler.ts)\n\nisTls = url.protocol === \"https:\"\n     || url.protocol === \"wss:\"\n\nif isTls:\n  tls.connect({\n    host, port,\n    rejectUnauthorized,\n    ca  ← upstream.tls.ca\n  })\nelse:\n  net.connect({ host, port })\n\nclientSocket.pipe(targetSocket)\ntargetSocket.pipe(clientSocket)\n\n⚡ Raw bidirectional TCP tunnel\n⚠  Workers NOT involved (Phase 1)\n[Phase 2: worker.send(rawSocket)]",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "WEBSOCKET PATH  (src/core/proxy/websocket.handler.ts)\n\nisTls = url.protocol === \"https:\"\n     || url.protocol === \"wss:\"\n\nif isTls:\n  tls.connect({\n    host, port,\n    rejectUnauthorized,\n    ca  ← upstream.tls.ca\n  })\nelse:\n  net.connect({ host, port })\n\nclientSocket.pipe(targetSocket)\ntargetSocket.pipe(clientSocket)\n\n⚡ Raw bidirectional TCP tunnel\n⚠  Workers NOT involved (Phase 1)\n[Phase 2: worker.send(rawSocket)]",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b4Q",
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
