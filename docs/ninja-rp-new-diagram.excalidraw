    {
      "id": "ko5sgy2WaEqdAouU-NoUB",
      "type": "text",
      "x": 16229.834381046112,
      "y": -3277.755101420068,
      "width": 1198.8133240365112,
      "height": 685.6522248985801,
      "angle": 0,
      "strokeColor": "#1e1e2e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1313608886,
      "version": 37,
      "versionNonce": 1052468586,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786391839416,
      "link": null,
      "locked": false,
      "text": "GitHub  (git push)\n   ↓\nJenkins Pipeline\n   ↓\nBuild  (npm install + npm run build)\n   ↓\nSonarQube  (code quality scan)\n   ↓\nQuality Gate  (pass / fail)\n   ↓\nTrivy FS Scan  (filesystem vulnerabilities)\n   ↓\nnpm test\n   ↓\nDocker Build  (multi-stage Dockerfile)\n   ↓\nDocker Push → pravi2005/reverse-proxy:latest\n   ↓\nTrivy Image Scan  (container vulnerabilities)\n   ↓\nDeploy Stage\n  ⚠  Prints message ONLY\n  kubectl apply NOT automated yet",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "GitHub  (git push)\n   ↓\nJenkins Pipeline\n   ↓\nBuild  (npm install + npm run build)\n   ↓\nSonarQube  (code quality scan)\n   ↓\nQuality Gate  (pass / fail)\n   ↓\nTrivy FS Scan  (filesystem vulnerabilities)\n   ↓\nnpm test\n   ↓\nDocker Build  (multi-stage Dockerfile)\n   ↓\nDocker Push → pravi2005/reverse-proxy:latest\n   ↓\nTrivy Image Scan  (container vulnerabilities)\n   ↓\nDeploy Stage\n  ⚠  Prints message ONLY\n  kubectl apply NOT automated yet",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b5i",
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "NauTSRSdiVHEX1eqqoQWX",
      "type": "rectangle",
      "x": 10574.896778500775,
