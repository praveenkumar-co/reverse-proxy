      "boundElements": [],
      "updated": 1786391839416,
      "link": null,
      "locked": false,
      "text": "❤  HEALTH CHECKER  (src/discovery/health/health.manager.ts)\n\ninitialHealthCheck() → runs ONCE at startup\n  (after 3s delay for workers to fork)\n\nstartHealthChecks() → every 10,000 ms\n\nPer upstream:\n  isHttps = url.protocol === \"https:\"\n  transport = isHttps ? https : http\n  GET upstream.healthPath  (/health)\n  TLS: rejectUnauthorized + custom CA\n\n  200 → HEALTHY_UPSTREAMS.add(id)\n  else → HEALTHY_UPSTREAMS.delete(id)",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "❤  HEALTH CHECKER  (src/discovery/health/health.manager.ts)\n\ninitialHealthCheck() → runs ONCE at startup\n  (after 3s delay for workers to fork)\n\nstartHealthChecks() → every 10,000 ms\n\nPer upstream:\n  isHttps = url.protocol === \"https:\"\n  transport = isHttps ? https : http\n  GET upstream.healthPath  (/health)\n  TLS: rejectUnauthorized + custom CA\n\n  200 → HEALTHY_UPSTREAMS.add(id)\n  else → HEALTHY_UPSTREAMS.delete(id)",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b4z",
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
