    {
      "id": "8cL4nmTP",
      "type": "text",
      "x": 16554,
      "y": -1869,
      "width": 3452,
      "height": 86,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
