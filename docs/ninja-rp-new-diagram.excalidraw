    },
    {
      "id": "AusgAu1z",
      "type": "text",
      "x": 14834,
      "y": -419,
      "width": 5172,
      "height": 86,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bYpZGByoI",
      "roundness": null,
      "seed": 454040574,
      "version": 1,
      "versionNonce": 364199322,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789874675272,
      "link": null,
      "locked": false,
      "created": null,
      "text": "• TagInvalidator: Inverted index Map<tag, Set<key>> for entity group purge\n• PatternInvalidator: Wildcard glob regex conversion & Redis KEYS bulk DEL\n• Debezium CDC Invalidator: Consumes Kafka database change events (c,u,d,r)\n  Extracts record ID (SQL & Mongo ObjectId) -> substitutes {id} in pathPattern\n  Purges affected cache entries automatically upon DB mutations!",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• TagInvalidator: Inverted index Map<tag, Set<key>> for entity group purge\n• PatternInvalidator: Wildcard glob regex conversion & Redis KEYS bulk DEL\n• Debezium CDC Invalidator: Consumes Kafka database change events (c,u,d,r)\n  Extracts record ID (SQL & Mongo ObjectId) -> substitutes {id} in pathPattern\n  Purges affected cache entries automatically upon DB mutations!",
      "autoResize": true,
      "lineHeight": 1.25
    },
