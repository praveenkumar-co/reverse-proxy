      "text": "🔌 WEBSOCKET DIRECT TUNNEL (src/core/proxy/websocket.handler.ts)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔌 WEBSOCKET DIRECT TUNNEL (src/core/proxy/websocket.handler.ts)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kaGXJSxs",
      "type": "text",
      "x": 9534,
      "y": 1361,
      "width": 3372,
      "height": 100,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bhjrA86zD",
      "roundness": null,
      "seed": 705943435,
      "version": 1,
      "versionNonce": 824382627,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789874675272,
      "link": null,
      "locked": false,
      "created": null,
      "text": "• HTTP 'upgrade' event intercepted on Master server\n• Fix #3: Route isolation enforced (destroys socket if route upstreams = 0)\n• Protocol resolution: if wss/https -> tls.connect; else -> net.connect\n• Fix #14: Passes tlsConfig with CA buffer on fallback tunneling\n• Full Duplex Pipe: clientSocket.pipe(target) <-> target.pipe(clientSocket)\n• Zero protocol overhead; sub-microsecond binary frame streaming!",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• HTTP 'upgrade' event intercepted on Master server\n• Fix #3: Route isolation enforced (destroys socket if route upstreams = 0)\n• Protocol resolution: if wss/https -> tls.connect; else -> net.connect\n• Fix #14: Passes tlsConfig with CA buffer on fallback tunneling\n• Full Duplex Pipe: clientSocket.pipe(target) <-> target.pipe(clientSocket)\n• Zero protocol overhead; sub-microsecond binary frame streaming!",
      "autoResize": true,
      "lineHeight": 1.25
    },
