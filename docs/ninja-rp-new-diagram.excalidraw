    },
    {
      "id": "FK2BDRBh",
      "type": "text",
      "x": 16594,
      "y": 2361,
      "width": 3372,
      "height": 130,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bN1r2Wk0B",
      "roundness": null,
      "seed": 894474163,
      "version": 1,
      "versionNonce": 929823746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789874675272,
      "link": null,
      "locked": false,
      "created": null,
      "text": "• parseYAMLConfig: Parses config.yaml & merges config.d/*.yaml in parallel\n• Inotify Watchers: fs.watch on config.yaml & config.d/ with 100ms debounce\n• SIGHUP Signal Handler: Triggers zero-downtime hot reload\n• reloadServerConfig() Safety Rebuild:\n  1. Fix #8: Calls circuitBreakerManager.clear() to discard stale breakers\n  2. Fix #7: Calls readinessProbe.clear() to prevent duplicate checks\n  3. Rebuilds LoadBalancer, Cache, and RateLimiters with full parity (Fix #10, #11)\n  4. Forks new workers and sends GRACEFUL_SHUTDOWN to old workers!",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• parseYAMLConfig: Parses config.yaml & merges config.d/*.yaml in parallel\n• Inotify Watchers: fs.watch on config.yaml & config.d/ with 100ms debounce\n• SIGHUP Signal Handler: Triggers zero-downtime hot reload\n• reloadServerConfig() Safety Rebuild:\n  1. Fix #8: Calls circuitBreakerManager.clear() to discard stale breakers\n  2. Fix #7: Calls readinessProbe.clear() to prevent duplicate checks\n  3. Rebuilds LoadBalancer, Cache, and RateLimiters with full parity (Fix #10, #11)\n  4. Forks new workers and sends GRACEFUL_SHUTDOWN to old workers!",
      "autoResize": true,
      "lineHeight": 1.25
    },
