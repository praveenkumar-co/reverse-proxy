    },
    {
      "id": "i4ifB9b_",
      "type": "text",
      "x": 9534,
      "y": 491,
      "width": 3372,
      "height": 86,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdIMAkWN4",
      "roundness": null,
      "seed": 320514411,
      "version": 1,
      "versionNonce": 685295293,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789874675272,
      "link": null,
      "locked": false,
      "created": null,
      "text": "• Selects worker: workers[index++ % N] round-robin\n• Generates correlation UUID (requestId)\n• Stores pending replyHandler Map<requestId, { res, upstreamId, timer, attempted }>\n• Sets connectTimeoutMs (5s) and readTimeoutMs (30s) safety timers\n• Dispatches workerMessageSchema JSON payload over Node cluster IPC channel",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Selects worker: workers[index++ % N] round-robin\n• Generates correlation UUID (requestId)\n• Stores pending replyHandler Map<requestId, { res, upstreamId, timer, attempted }>\n• Sets connectTimeoutMs (5s) and readTimeoutMs (30s) safety timers\n• Dispatches workerMessageSchema JSON payload over Node cluster IPC channel",
      "autoResize": true,
      "lineHeight": 1.25
    },
