      "boundElements": [],
      "updated": 1786457026457,
      "link": null,
      "locked": false,
      "text": "🗃  REDIS CACHE  (src/cache/cache-manager.ts)\n\nhost: redis  (same K8s namespace)\nport: 6379  |  TTL: 60s\n\nOPS:\n  buildKey(method,url) → \"proxy:GET:/path\"\n  get(key) → string | null\n  set(key, value, {EX: ttl})\n  invalidate(pattern) → KEYS → DEL\n\nreconnect: exponential backoff, max 5 retries\n\n⚠  enabled: false  (current config.yaml)",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "🗃  REDIS CACHE  (src/cache/cache-manager.ts)\n\nhost: redis  (same K8s namespace)\nport: 6379  |  TTL: 60s\n\nOPS:\n  buildKey(method,url) → \"proxy:GET:/path\"\n  get(key) → string | null\n  set(key, value, {EX: ttl})\n  invalidate(pattern) → KEYS → DEL\n\nreconnect: exponential backoff, max 5 retries\n\n⚠  enabled: false  (current config.yaml)",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b4v",
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
