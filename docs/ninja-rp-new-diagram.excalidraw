    },
    {
      "id": "QFe5YDrC0h6B-U5nyyp8K",
      "type": "text",
      "x": 10618.893946694721,
      "y": -4560.657849264896,
      "width": 1584.9249267578125,
      "height": 291.07877472109533,
      "angle": 0,
      "strokeColor": "#1e1e2e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1263231414,
      "version": 39,
      "versionNonce": 1358221372,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789749167962,
      "link": null,
      "locked": false,
      "text": "FLOW:  config.yaml  →  fs.readFile()  →  yaml.parse()  →  check config.d/*.yaml  →  Promise.all(parallel parse)\n  →  merge(upstreams + paths + headers)  →  rootConfigSchema (Zod)  →  validateConfig()  →  ConfigSchemaType\n\nZOD validates:  server.listen | httpsPort | workers | upstreams[].{id,url,weight,healthPath,tls{rejectUnauthorized,ca}}\n  | loadBalancing.{strategy, failureThreshold, recoveryTimeMs, retry.{maxAttempts, statusCodes}}\n  | cache.{enabled,host,port,ttlSeconds} | paths[].{path,upstream[],rateLimit,sticky}\n\nHOT RELOAD:  fs.watch(\"change\") || SIGHUP  →  100ms debounce  →  re-parse+validate\n  →  reloadServerConfig()  →  cluster.fork(N new workers)  →  old.send(GRACEFUL_SHUTDOWN)  →  SIGTERM after 15s",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "FLOW:  config.yaml  →  fs.readFile()  →  yaml.parse()  →  check config.d/*.yaml  →  Promise.all(parallel parse)\n  →  merge(upstreams + paths + headers)  →  rootConfigSchema (Zod)  →  validateConfig()  →  ConfigSchemaType\n\nZOD validates:  server.listen | httpsPort | workers | upstreams[].{id,url,weight,healthPath,tls{rejectUnauthorized,ca}}\n  | loadBalancing.{strategy, failureThreshold, recoveryTimeMs, retry.{maxAttempts, statusCodes}}\n  | cache.{enabled,host,port,ttlSeconds} | paths[].{path,upstream[],rateLimit,sticky}\n\nHOT RELOAD:  fs.watch(\"change\") || SIGHUP  →  100ms debounce  →  re-parse+validate\n  →  reloadServerConfig()  →  cluster.fork(N new workers)  →  old.send(GRACEFUL_SHUTDOWN)  →  SIGTERM after 15s",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b5G",
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
