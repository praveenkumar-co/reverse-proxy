    {
      "id": "bofP-1IhS_ijpZIwyrcQw",
      "type": "text",
      "x": 12995.625773033942,
      "y": -3864.224929006275,
      "width": 419.6629943847656,
      "height": 873.236324163286,
      "angle": 0,
      "strokeColor": "#1e1e2e",
      "backgroundColor": "transparent",
