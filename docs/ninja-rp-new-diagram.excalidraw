      "seed": 843006134,
      "version": 38,
      "versionNonce": 1089579071,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786535324727,
      "link": null,
      "locked": false,
      "text": "PROXY POD\n(ninja-reverse-proxy)\n\nreplicas: 1\n\nContains:\n  Master + Workers (cluster)\n\nPorts:\n  8080 HTTP\n  8443 HTTPS\n\nEnv: APP_CONFIG (JSON string)\n\nVolume mounts:\n  ConfigMap → /app/config.yaml\n  Secret → cert.pem + key.pem\n\nProbes:\n  readiness: GET /__lb-stats\n  liveness:  GET /__lb-stats\n\nUpstreams (in-cluster DNS):\n  backend-a-svc:3001\n  backend-b-svc:3002\n\nnamespace: reverse-proxy",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "PROXY POD\n(ninja-reverse-proxy)\n\nreplicas: 1\n\nContains:\n  Master + Workers (cluster)\n\nPorts:\n  8080 HTTP\n  8443 HTTPS\n\nEnv: APP_CONFIG (JSON string)\n\nVolume mounts:\n  ConfigMap → /app/config.yaml\n  Secret → cert.pem + key.pem\n\nProbes:\n  readiness: GET /__lb-stats\n  liveness:  GET /__lb-stats\n\nUpstreams (in-cluster DNS):\n  backend-a-svc:3001\n  backend-b-svc:3002\n\nnamespace: reverse-proxy",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b5S",
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
