    {
      "id": "3AVfJ_pGeoMOcFZABX4Mu",
      "type": "text",
      "x": 16229.834381046112,
      "y": -6063.486782454551,
      "width": 1198.8133240365112,
      "height": 687.8083639705883,
      "angle": 0,
      "strokeColor": "#1e1e2e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
