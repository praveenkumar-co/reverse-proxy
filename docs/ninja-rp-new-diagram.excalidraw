      "locked": false,
      "text": "📊  METRICS REGISTRY  (src/observability/metrics/prometheus.exporter.ts)\n\nGET /metrics  →  Prometheus exposition format\n\nninja_http_requests_total\n  {method, path, status, upstream_id}\nninja_http_request_duration_seconds_sum\nninja_http_request_duration_seconds_count\nninja_active_connections{upstream_id}\nninja_cache_operations_total{action=hit|miss}\nninja_upstream_status{upstream_id}  1=UP / 0=DOWN",
      "fontSize": 25.873668864097365,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "📊  METRICS REGISTRY  (src/observability/metrics/prometheus.exporter.ts)\n\nGET /metrics  →  Prometheus exposition format\n\nninja_http_requests_total\n  {method, path, status, upstream_id}\nninja_http_request_duration_seconds_sum\nninja_http_request_duration_seconds_count\nninja_active_connections{upstream_id}\nninja_cache_operations_total{action=hit|miss}\nninja_upstream_status{upstream_id}  1=UP / 0=DOWN",
