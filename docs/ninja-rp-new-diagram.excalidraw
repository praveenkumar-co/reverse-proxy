      "boundElements": [],
      "updated": 1786391839416,
      "link": null,
      "locked": false,
      "text": "🔥  PROMETHEUS\n\nscrape_configs:\n  - targets: [host.docker.internal:8443]\n    metrics_path: /metrics\n    scheme: https\n    tls_config: {insecure_skip_verify: true}\nscrape_interval: 5s\n\nPromQL queries + alerting rules",
      "fontSize": 28.029807936105477,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
