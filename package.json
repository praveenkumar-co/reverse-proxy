{
  "name": "ninja-reverse-proxy",
  "version": "1.2.2",
  "description": "A production-grade reverse proxy with load balancing, circuit breaker, sticky sessions, and dynamic service registry.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ninja-reverse-proxy": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "dev": "tsc-watch --onSuccess \"node dist/index.js --config config.yaml\"",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/unit/**/*.js dist-test/tests/integration/*.js",
    "test:audit": "node tests/full-system-audit.mjs",
    "test:preflight": "node tests/production-preflight-check.mjs",
    "test:showcase": "node tests/executive-showcase-suite.mjs",
    "test:ddia": "node tests/ddia-benchmarks-test.mjs",
    "test:replication": "node tests/ddia-replication-suite.mjs",
    "test:replication:extreme": "node tests/ddia-replication-extreme-chaos.mjs",
    "test:transactions": "node tests/ddia-transactions-suite.mjs",
    "test:live": "node tests/live-integration-test.mjs",
    "test:universal": "node tests/universal-app-test.mjs",
    "generate-certs": "bash scripts/generate-certs.sh",
    "lint": "eslint src --ext .ts",
    "test:exploit": "node tests/adversarial-exploit-harness.mjs"
  },
  "keywords": [
    "reverse-proxy",
    "load-balancer",
    "circuit-breaker",
    "nginx",
    "gateway",
    "sticky-session",
    "rate-limiter",
    "proxy"
  ],
  "author": "praveenkumar-co",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/praveenkumar-co/reverse-proxy.git"
  },
  "homepage": "https://github.com/praveenkumar-co/reverse-proxy#readme",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "redis": "^5.11.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
