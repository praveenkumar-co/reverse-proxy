{
  "name": "ninja-reverse-proxy",
  "version": "1.0.6",
  "description": "A production-grade reverse proxy with load balancing, circuit breaker, sticky sessions, and dynamic service registry.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ninja-reverse-proxy": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "dev": "tsc-watch --onSuccess \"node dist/index.js --config config.yaml\"",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/unit/**/*.js dist-test/tests/integration/*.js",
    "generate-certs": "bash scripts/generate-certs.sh",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "reverse-proxy",
    "load-balancer",
    "circuit-breaker",
    "nginx",
    "gateway",
    "sticky-session",
    "rate-limiter",
    "proxy"
  ],
  "author": "praveenkumar-co",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/praveenkumar-co/reverse-proxy.git"
  },
  "homepage": "https://github.com/praveenkumar-co/reverse-proxy#readme",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "redis": "^5.11.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
